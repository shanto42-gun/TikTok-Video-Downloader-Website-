# TikSave Environment Configuration

# Optional: Set an external licensed TikTok extraction provider endpoint
# If left unset, TikSave runs in high-fidelity built-in mock/demo mode
# TIKTOK_API_ENDPOINT=https://your-media-provider.com/api/extract
# TIKTOK_API_KEY=your_secret_api_key

# Optional: Upstash Redis Rate Limiting (for production scale)
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...
